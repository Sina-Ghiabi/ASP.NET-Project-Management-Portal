</div>

<div class="modal fade" id="hrMonthlyByProjectModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="hrMonthlyByProjectModalTitle"></h4>
            </div>
            <div class="modal-body">
                <p class="text-center">Each Project's Share of the Company's Workforce in Month <span id="hrMonthlyByProjectMonth_Title"></span> of Year <span id="hrMonthlyByProjectYear_Title"></span></p>
                <div style="padding: 0 110px 57px;">
                    <div class="chart-container" style="position: relative; width:700px; height:500px;">
                        <canvas id="hrMonthlyByProject"></canvas>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">Close</button>
            </div>
