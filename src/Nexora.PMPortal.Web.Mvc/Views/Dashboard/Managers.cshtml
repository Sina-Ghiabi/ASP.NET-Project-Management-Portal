@model Nexora.PMPortal.Web.ViewModels.ManagerDashboardViewModel
@{
    ViewData["Title"] = "Index";
}

<div class="row">
    <div class="col-lg-12">
        <div class="btn-group btn-group-justified" role="group" aria-label="Justified button group">
            @if (IsGranted("PmPortal.Dashboard.Projects"))
            {
                <a href="@Url.Action("Index","Home")" class="btn bg-blue-grey waves-effect no-radius" role="button">Projects Dashboard</a>
            }
            @if (IsGranted("PmPortal.Dashboard.Allocation"))
            {
                <a href="@Url.Action("Allocation","Home")" class="btn bg-indigo waves-effect no-radius" role="button">Allocation Dashboard</a>
            }
            @if (IsGranted("PmPortal.Dashboard.Managers"))
            {
                <a href="@Url.Action("Managers","Dashboard")" class="btn bg-teal waves-effect no-radius dashboard-active" role="button">Management Dashboard</a>
            }
            @if (IsGranted("PmPortal.Dashboard.ProjectsDocumentations"))
            {
                <a href="@Url.Action("ProjectsDocumentations","Dashboard")" class="btn bg-primary waves-effect no-radius" role="button">Engineering Dashboard</a>
            }
        </div>
    </div>
</div>
@if (IsGranted("PmPortal.Dashboard.Managers"))
{

