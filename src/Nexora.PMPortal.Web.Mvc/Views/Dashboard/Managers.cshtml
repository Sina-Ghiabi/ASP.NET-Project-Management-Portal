<div class="modal fade" id="hrMonthlyModal" tabindex="-1" role="dialog">
    <input type="hidden" id="hrMonthlySelectedYear" value="0" />
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="hrMonthlyModalTitle"></h4>
            </div>
            <div class="modal-body">
                <p class="text-center">Company Workforce Count by Month in Year <span id="hrMonthly_Title"></span></p>
                <div class="chart-container" style="position: relative; height:auto;">
                    <canvas id="hrMonthly"></canvas>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
