</div>
}
<script>

    $(document).ready(function () {
        getData($("#DefaultYear").val());
    });

    $("#DefaultYear").change(function () {
        getData($("#DefaultYear").val());
    });

    function getData(year) {
        loadforooshByType(year);
        loadforooshByServiceType(year);
        loadroshdForoosh(year);
        loadroshdForooshWithLastYear(year);
        loadhashieSoodNakhales(year);
        loadhashieSoodkhales(year);
        loadHrYearly(year);
        loadHrBySales(year);
        LoadZemanatNameChart(year);
    }

    //#region forooshByType

    var ctx_forooshByType = document.getElementById('forooshByType');
    var forooshByTypeChart = new Chart(ctx_forooshByType, {
        type: 'bar',
        data: {
            labels: [],
            datasets: [
                {
                    label: "Total Sales",
                    data: [],
                    backgroundColor: 'rgba(90, 198, 12, 0.0)',
                    borderColor: 'rgba(190, 15, 155)',
                    type: 'line'

                },
                {
                    label: 'Recycled Sales',
                    data: [],
                    backgroundColor: 'rgba(228, 200, 253)',
                    type: 'bar'
                },
                {
                    label: 'Approved Sales',
                    data: [],
                    backgroundColor: 'rgba(188, 74, 255)',

                    // Changes this dataset to become a line
                    type: 'bar'
                },

            ]
        },
        options: {
            responsive: true,
            legend: {
                position: 'bottom',
                align: 'end',
                labels: {
                    fontFamily: 'Shabnam',
                    fontColor: 'black'
                }
            },
            tooltips: {
                mode: 'label',
                label: 'mylabel',
                callbacks: {
                    label: function (tooltipItem, data) {
                        var tooltipValue = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        return data.datasets[tooltipItem.datasetIndex].label + " : " + parseInt(tooltipValue).toLocaleString();
                    },
                },
                titleFontFamily: "Shabnam",
                bodyFontFamily: "Shabnam"
            },
            scales: {
                xAxes: [{
                    stacked: true,
                    ticks: {
                        beginAtZero: true,
                        userCallback: function (value, index, values) {
                            if (value.includes("annual")) {
                                value = value.toString();
                                value = value.split("annual");
                                value = value.join('');
                                return value;
                            }
                            else if(value.includes("month")){
                                value = value.toString();
                                value = value.split("month");
                                value = value.join(' month ');
                                return value;
                            }
                        }
                    }
                }],

                yAxes: [{
                    stacked: true,
                    ticks: {
                        beginAtZero: true,
                        userCallback: function (value, index, values) {
                            value = value.toString();
                            value = value.split(/(?=(?:...)*$)/);
                            value = value.join(',');
                            return value;
                        }
                    }
                }]
            },
            onClick: function (c, i) {
                e = i[0];
                var x_value = this.data.labels[e._index];
                if (x_value.includes("month")) {
                    x_value = x_value.split(/([0-9]+)/)[3];
                } else {
                    x_value = x_value.split(/([0-9]+)/)[1];
                }
                $("#forooshByTypeYearly_Title").html(x_value);
                LoadforooshByTypeYearly(x_value);
            }

        }
    });



    var ctx_forooshByTypeYearly = document.getElementById('forooshByTypeYearly');
    var forooshByTypeYearlyChart = new Chart(ctx_forooshByTypeYearly, {
        type: 'pie',
        data: {
            labels: [],
            datasets: [
                {
                    label: 'x`',
                    data: [],
                    backgroundColor: [],
                    type: 'pie'
                },
            ]
        },
        options: {
            responsive: true,
            legend: {
                position: 'right',
                align: 'center',
                labels: {
                    fontFamily: 'Shabnam',
                    fontColor: 'black'
                }
            },
            tooltips: {
                mode: 'label',
                label: 'mylabel',
                callbacks: {
                    label: function (tooltipItem, data) {
                        var tooltipValue = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        return data.datasets[tooltipItem.datasetIndex].label[tooltipItem.index] + " : %" + tooltipValue.toLocaleString();
                    },
                },
                titleFontFamily: "Shabnam",
                bodyFontFamily: "Shabnam"
            }
        }

    });


    function LoadforooshByTypeYearly(year) {
        $.ajax({
            url: '/Dashboard/GetforooshByTypeYearlyChartData',
            data: { "year": year },
            success: function (data) {
                forooshByTypeYearlyChart.data.labels = [];

                data.projects.forEach(function (element) {
                    forooshByTypeYearlyChart.data.labels.push(element);
                });

                forooshByTypeYearlyChart.data.datasets[0].label = [];

                data.projects.forEach(function (element) {
                    forooshByTypeYearlyChart.data.datasets[0].label.push(element);
                });



                forooshByTypeYearlyChart.data.datasets[0].data = [];
                data.colors.forEach(function (element) {
                    forooshByTypeYearlyChart.data.datasets[0].backgroundColor.push(element);
                });

                forooshByTypeYearlyChart.data.datasets[0].data = [];
                data.yearlySales.forEach(function (element) {
                    forooshByTypeYearlyChart.data.datasets[0].data.push(element);
                });


                forooshByTypeYearlyChart.update();
            }
        });

        $('#forooshByTypeYearlyModal').modal('show');
    }



    function loadforooshByType(year) {
        $.ajax({
            url: '/Dashboard/GetforooshByTypeChartData',
            data: { "year": year },
            success: function (data) {
                var Years = [];
                var Months = "";
                LastMonth = [];
                forooshByTypeChart.data.labels = [];

                data.years.forEach(function (element) {
                    Years.push(element)
                });

                data.lastmonth.forEach(function (element) {
                    Months = element;
                    LastMonth.push(Months[0]);
                });

                for (var Index = 0; Index <= Years.length - 1; Index++) {
                    forooshByTypeChart.data.labels.push(LastMonth[Index] + Years[Index]);
                }

                forooshByTypeChart.data.datasets[0].data = [];
                data.totalSales.forEach(function (element) {
                    forooshByTypeChart.data.datasets[0].data.push(element);
                });

                forooshByTypeChart.data.datasets[1].data = [];
                data.recycleSales.forEach(function (element) {
                    forooshByTypeChart.data.datasets[1].data.push(element);
                });

                forooshByTypeChart.data.datasets[2].data = [];
                data.approvedSales.forEach(function (element) {
                    forooshByTypeChart.data.datasets[2].data.push(element);
                });

                // re-render the chart
                forooshByTypeChart.update();
            }
        });
    }

    //#endregion

    //#region forooshByServiceType

    var ctx_forooshByServiceType = document.getElementById('forooshByServiceType');
    var forooshByServiceTypeChart = new Chart(ctx_forooshByServiceType, {
        type: 'bar',
        data: {
            labels: [],
            datasets: [
                {
                    label: "Total Sales",
                    data: [],
                    backgroundColor: 'rgba(90, 198, 12, 0.0)',
                    borderColor: 'rgba(190, 15, 155)',
                    type: 'line'

                },
                {
                    label: 'Water and Wastewater',
                    data: [],
                    backgroundColor: 'rgba(255, 228, 121)',
                    type: 'bar'
                },
                {
                    label: 'Power and Energy',
                    data: [],
                    backgroundColor: 'rgba(206, 169, 251)',
                    type: 'bar'
                },
                {
                    label: 'Utility',
                    data: [],
                    backgroundColor: 'rgba(90, 181, 207)',
                    type: 'bar'
                },
                {
                    label: 'Water Supply and Distribution',
                    data: [],
                    backgroundColor: 'rgba(134, 255, 255)',
                    type: 'bar'
                },
                {
                    label: 'Industrial Development',
                    data: [],
                    backgroundColor: 'rgba(255, 162, 76)',
                    type: 'bar'
                }

            ]
        },
        options: {
            responsive: true,
            legend: {
                position: 'bottom',
                align: 'end',
                labels: {
                    fontFamily: 'Shabnam',
                    fontColor: 'black'
                }
            },
            tooltips: {
                mode: 'label',
                label: 'mylabel',
                callbacks: {
                    label: function (tooltipItem, data) {
                        var tooltipValue = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        return data.datasets[tooltipItem.datasetIndex].label + " : " + parseInt(tooltipValue).toLocaleString();
                    },
                },
                titleFontFamily: "Shabnam",
                bodyFontFamily: "Shabnam"
            },
            scales: {
                xAxes: [{
                    stacked: true,
                    ticks: {
                        beginAtZero: true,
                        userCallback: function (value, index, values) {
                            if (value.includes("annual")) {
                                value = value.toString();
                                value = value.split("annual");
                                value = value.join('');
                                return value;
                            }
                            else if (value.includes("month")) {
                                value = value.toString();
                                value = value.split("month");
                                value = value.join(' month ');
                                return value;
                            }
                        }
                    }
                }],

                yAxes: [{
                    stacked: true,
                    ticks: {
                        beginAtZero: true,
                        userCallback: function (value, index, values) {
                            value = value.toString();
                            value = value.split(/(?=(?:...)*$)/);
                            value = value.join(',');
                            return value;
                        }
                    }
                }]
            },
            onClick: function (c, i) {
                e = i[0];
                var x_value = this.data.labels[e._index];
                if (x_value.includes("month")) {
                    x_value = x_value.split(/([0-9]+)/)[3];
                } else {
                    x_value = x_value.split(/([0-9]+)/)[1];
                }
                //var y_value = this.data.datasets[0].data[e._index];
                LoadforooshByTypeProjects(x_value);
            }

        }
    });


    function LoadforooshByTypeProjects(year) {
        $.ajax({
            url: '/Dashboard/GetforooshByTypeYearlyProjectsData',
            data: { "year": year },
            success: function (data) {
                if (data.waterAndWasteWater) {
                    $("#Box_WaterAndWasteWater").show();
                    $("#Box_WaterAndWasteWater_Wrapper").html(data.waterAndWasteWater);
                }
                else {
                    $("#Box_WaterAndWasteWater").hide();
                    $("#Box_WaterAndWasteWater_Wrapper").html("");
                }
                if (data.waterSupply) {
                    $("#Box_WaterSupply").show();
                    $("#Box_WaterSupply_Wrapper").html(data.waterSupply);
                }
                else {
                    $("#Box_WaterSupply").hide();
                    $("#Box_WaterSupply_Wrapper").html("");
                }
                if (data.electricityAndEnergy) {
                    $("#Box_ElectricityAndEnergy").show();
                    $("#Box_ElectricityAndEnergy_Wrapper").html(data.electricityAndEnergy);
                }
                else {
                    $("#Box_ElectricityAndEnergy").hide();
                    $("#Box_ElectricityAndEnergy_Wrapper").html("");
                }
                if (data.industrialDevelopment) {
                    $("#Box_IndustrialDevelopment").show();
                    $("#Box_IndustrialDevelopment_Wrapper").html(data.industrialDevelopment);
                }
                else {
                    $("#Box_IndustrialDevelopment").hide();
                    $("#Box_IndustrialDevelopment_Wrapper").html("");
                }
                if (data.utilty) {
                    $("#Box_Utilty").show();
                    $("#Box_Utilty_Wrapper").html(data.utilty);
                }
                else {
                    $("#Box_Utilty").hide();
                    $("#Box_Utilty_Wrapper").html("");
                }


                $('#forooshByServiceTypeProjectsModal').modal('show');
            }
        });

    }


    function loadforooshByServiceType(year) {
        $.ajax({
            url: '/Dashboard/GetforooshByServiceTypeChartData',
            data: { "year": year },
            success: function (data) {
                var Years = [];
                var LastMonth = [];
                forooshByServiceTypeChart.data.labels = [];

                data.years.forEach(function (element) {
                   Years.push(element);
                });

                data.lastmonth.forEach(function (element) {
                    LastMonth.push(element.split(",").pop());
                });

                for (var Index=0; Index <= Years.length-1; Index++) {
                    forooshByServiceTypeChart.data.labels.push(LastMonth[Index] + Years[Index]);
                }

                forooshByServiceTypeChart.data.datasets[0].data = [];
                data.totalSales.forEach(function (element) {
                    forooshByServiceTypeChart.data.datasets[0].data.push(element);
                });

                forooshByServiceTypeChart.data.datasets[1].data = [];
                data.waterAndWasteWater.forEach(function (element) {
                    forooshByServiceTypeChart.data.datasets[1].data.push(element);
                });

                forooshByServiceTypeChart.data.datasets[2].data = [];
                data.electricityAndEnergy.forEach(function (element) {
                    forooshByServiceTypeChart.data.datasets[2].data.push(element);
                });

                forooshByServiceTypeChart.data.datasets[3].data = [];
                data.utilty.forEach(function (element) {
                    forooshByServiceTypeChart.data.datasets[3].data.push(element);
                });

