                });

                forooshSalaneChart.data.datasets[2].data = [];
                data.approvedSales.forEach(function (element) {
                    forooshSalaneChart.data.datasets[2].data.push(element);
                });

                // re-render the chart
                forooshSalaneChart.update();
            }
        });


