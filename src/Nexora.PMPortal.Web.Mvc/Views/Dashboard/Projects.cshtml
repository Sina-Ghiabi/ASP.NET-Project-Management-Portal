    function LoadMothProgressPercentageChart(projectId, year, month) {
        $.ajax({
            url: '/Dashboard/GetProgressPercentageMonthChartDatas',
            data: { "projectId": projectId, "year": year, "month": month },
            success: function (data) {

                darsadPishraftMonth_Engineering.data.datasets[0].data = [];
                darsadPishraftMonth_Engineering.data.datasets[0].data.push(data.plans_Engineering);
