                });

                daryadftPardakhtSalaneChart.data.datasets[1].data = [];
                data.payments.forEach(function (element) {
                    daryadftPardakhtSalaneChart.data.datasets[1].data.push(element);
                });

                daryadftPardakhtSalaneChart.data.datasets[2].data = [];
                data.receivesTajamoyi.forEach(function (element) {
                    daryadftPardakhtSalaneChart.data.datasets[2].data.push(element);
                });

