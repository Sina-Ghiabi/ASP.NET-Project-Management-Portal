    var getData = function (projectId) {

        $.ajax({
            url: '/Dashboard/GetCostBenefitChartDatas',
            data: { "projectId": projectId },
            success: function (data) {
                hashieSoodChart.data.labels = [];

                data.years.forEach(function (element) {
                    hashieSoodChart.data.labels.push(element);
                });

                hashieSoodChart.data.datasets[0].data = [];
                data.profits.forEach(function (element) {
                    hashieSoodChart.data.datasets[0].data.push(element);
                });

                // re-render the chart
                hashieSoodChart.update();
            }
        });

        $.ajax({
            url: '/Dashboard/GetCostBenefitSaleChartDatas',
            data: { "projectId": projectId },
            success: function (data) {
