                data: [],
                backgroundColor: 'rgba(253,152,253)'
            }]
        },
        options: {
            responsive: true,
            legend: {
                position: 'bottom',
                align: 'end',
                labels: {
                    fontFamily: 'Shabnam',
                    fontColor: 'black'
                }
            },
            tooltips: {
                mode: 'label',
                label: 'mylabel',
                callbacks: {
                    label: function (tooltipItem, data) {
                        var tooltipValue = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        return data.datasets[tooltipItem.datasetIndex].label + " : " + parseInt(tooltipValue).toLocaleString();
                    },
                },
                titleFontFamily: "Shabnam",
                bodyFontFamily: "Shabnam"
            },
            scales: {
                yAxes: [{
                    ticks: {
                        beginAtZero: true
                    }
                }]
            }
        }
    });

    function LoadMothlyLaborChart(projectId, year) {
        $("#laborMonthlyChartModalTitle").html("Monthly Personnel Report for Year " + year);
        $.ajax({
            url: '/Dashboard/GetlaborInventoryMonthlyChartDatas',
            data: { "projectId": projectId, "year": year },
            success: function (data) {
                nirooEnsaniMonthly.data.labels = [];

                data.month.forEach(function (element) {
                    nirooEnsaniMonthly.data.labels.push(element);
                });

                nirooEnsaniMonthly.data.datasets[0].data = [];
                data.labors.forEach(function (element) {
                    nirooEnsaniMonthly.data.datasets[0].data.push(element);
                });

                $('#laborMonthlyChartModal').modal('show');

                // re-render the chart
                nirooEnsaniMonthly.update();

            }
        });
    }


</script>



