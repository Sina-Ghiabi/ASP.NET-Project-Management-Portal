    function LoadMothlyProgressChart(projectId, year) {
        $("#CurrentProgressYear").val(year);
        $("#darsadPishraftMonthlyChartModalTitle").html("Periodic Progress Percentage for Year " + year);
        $.ajax({
            url: '/Dashboard/GetProgressPercentageMonthlyChartDatas',
            data: { "projectId": projectId, "year": year },
            success: function (data) {
                darsadPishraftMonthly.data.labels = [];

                data.months.forEach(function (element) {
                    darsadPishraftMonthly.data.labels.push(element);
                });

                darsadPishraftMonthly.data.datasets[0].data = [];
                data.plans.forEach(function (element) {
                    darsadPishraftMonthly.data.datasets[0].data.push(element);
                });

                darsadPishraftMonthly.data.datasets[1].data = [];
                data.reals.forEach(function (element) {
                    darsadPishraftMonthly.data.datasets[1].data.push(element);
                });

                $('#progressMonthlyChartModal').modal('show');

                // re-render the chart
                darsadPishraftMonthly.update();

            }
        });
    }
</script>





