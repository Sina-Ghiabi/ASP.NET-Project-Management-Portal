</script>





<div class="modal fade" id="laborMonthlyChartModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="laborMonthlyChartModalTitle">----</h4>
            </div>
            <div class="modal-body">
                <div class="chart-container" style="position: relative; height:auto;">
                    <canvas id="laborMonthlyChart"></canvas>
