@using Nexora.PMPortal.Web.Startup
@model Nexora.PMPortal.Web.Models.Roles.EditRoleModalViewModel

@{
    ViewBag.CurrentPageName = PageNames.Roles;
}
<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <div class="row">
                    <div class="col-md-4">
                        <h2>
                            Add New Role
                        </h2>
                    </div>
                    <div class="col-md-8">
                        <a href="@Url.Action("Index", "Roles")" class="btn btn-warning btn-create  pull-right">Back to Role List</a>
                    </div>
                </div>

            </div>
            <div class="body">
                @using (Html.BeginForm("Create", "Roles", FormMethod.Post))
                {
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input id="rolename" type="text" name="Role.Name" value="" required maxlength="32" minlength="2" class="validate form-control">
                                    <label for="rolename" class="form-label">Name (English)</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    <input id="displayname" type="text" name="Role.DisplayName" value="" required maxlength="32" minlength="2" class="validate form-control">
                                    <label for="displayname" class="form-label">Display Name</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    @*<div class="row">
                            <div class="col-sm-12">
                                <div class="form-group form-float">
                                    <div class="form-line">
                                        <textarea id="role-description" name="Description" class="validate form-control">@Model.Role.Description</textarea>
                                        <label for="role-description" class="form-label">@L("RoleDescription")</label>
                                    </div>
                                </div>
                            </div>
                        </div>*@
                    <div class="row clearfix">
                        <div class="col-sm-12">
                            <h4>Permissions</h4>
                            <hr />
                            <div class="permissions">
                                @foreach (var permission in Model.Permissions.Where(a => a.Parent == null))
                                {
                                    if (permission.Children.Count() > 0)
                                    {
                                        <div class="col-sm-12 parent-first">
                                            <input type="checkbox" name="GrantedPermissionNames" value="@permission.Name" class="filled-in chk-col-blue" id="@string.Format("permission{0}", permission.Name)" />
                                            <label for="@string.Format("permission{0}", permission.Name)">@permission.DisplayName (@permission.Children.Count())</label>
                                        </div>
                                        @foreach (var firstChild in permission.Children)
                                        {

                                            if (firstChild.Children.Count() > 0)
                                            {
                                                <div class="col-sm-12 parent-first" style="padding-right:30px;">
                                                    <input type="checkbox" name="GrantedPermissionNames" value="@firstChild.Name" class="filled-in chk-col-blue" id="@string.Format("permission{0}", firstChild.Name)"/>
                                                    <label for="@string.Format("permission{0}", firstChild.Name)">@firstChild.DisplayName (@firstChild.Children.Count())</label>
                                                </div>
                                                @foreach (var secondChild in firstChild.Children)
                                                {
                                                    if (secondChild.Children.Count() > 0)
                                                    {
                                                        <div class="col-sm-12 parent-second" style="padding-right:60px;">
                                                            <input type="checkbox" name="GrantedPermissionNames" value="@secondChild.Name" class="filled-in chk-col-blue" id="@string.Format("permission{0}", secondChild.Name)"  />
                                                            <label for="@string.Format("permission{0}", secondChild.Name)">@secondChild.DisplayName (@secondChild.Children.Count())</label>
                                                        </div>
                                                        @foreach (var thirdChildren in secondChild.Children)
                                                        {
                                                            <div class="col-sm-12 third-child-bg" style="padding-right:100px;">
                                                                <input type="checkbox" name="GrantedPermissionNames" value="@thirdChildren.Name" class="filled-in chk-col-blue" id="@string.Format("permission{0}", thirdChildren.Name)"  />
                                                                <label for="@string.Format("permission{0}", thirdChildren.Name)">@thirdChildren.DisplayName</label>
                                                            </div>
                                                        }

                                                    }
                                                    else
                                                    {
                                                        <div class="col-sm-12 child-bg" style="padding-right:60px;">
                                                            <input type="checkbox" name="GrantedPermissionNames" value="@secondChild.Name" class="filled-in chk-col-blue" id="@string.Format("permission{0}", secondChild.Name)" />
                                                            <label for="@string.Format("permission{0}", secondChild.Name)">@secondChild.DisplayName</label>
                                                        </div>
                                                    }
                                                }

                                            }
                                            else
                                            {
                                                <div class="col-sm-12 child-bg" style="padding-right:30px;">
                                                    <input type="checkbox" name="GrantedPermissionNames" value="@firstChild.Name" class="filled-in chk-col-blue" id="@string.Format("permission{0}", firstChild.Name)" />
                                                    <label for="@string.Format("permission{0}", firstChild.Name)">@firstChild.DisplayName</label>
                                                </div>
                                            }
                                        }

                                        break;
                                    }
                                    else
                                    {
                                        <div class="col-sm-12">
                                            <input type="checkbox" name="GrantedPermissionNames" value="@permission.Name" class="filled-in chk-col-blue" id="@string.Format("permission{0}", permission.Name)" />
                                            <label for="@string.Format("permission{0}", permission.Name)">@permission.DisplayName (@permission.Children.Count())</label>
                                        </div>
                                    }
                                }
                            </div>

                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary waves-effect">Save</button>

                }
            </div>
        </div>
    </div>
</div>

<style>
    .parent-first {
        background-color: #bebebe;
        padding: 10px 9px 0px 10px;
        margin-bottom: 5px !important;
    }

    .parent-second {
        background-color: #d8d6d6;
        padding: 10px 9px 0px 10px;
        margin-bottom: 5px !important;
    }

    .child-bg {
        background-color: #dcf3f8;
        padding: 10px 9px 0px 10px;
        margin-bottom: 5px !important;
    }

    .third-child-bg {
        background-color: #fff7cd;
        padding: 10px 9px 0px 10px;
        margin-bottom: 5px !important;
    }

    .permissions {
        height: 400px;
        overflow-y: scroll;
    }
</style>