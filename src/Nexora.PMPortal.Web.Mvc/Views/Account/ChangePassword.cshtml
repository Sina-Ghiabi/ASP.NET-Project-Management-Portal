@model Nexora.PMPortal.Web.Models.Account.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <div class="row">
                    <div class="col-md-4">
                        <h2>
                            Change Password
                        </h2>
                    </div>
                    <div class="col-md-8">
                    </div>
                </div>

            </div>
            <div class="body">

                @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @class = "", role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.UserId)
                    <div class="row">
                        <div class="col-md-12">
                            <label for="">New Password</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.Password, new { @class = "form-control", placeholder = "", required = "true" })
                                </div>
                            </div>
                        </div>

                    </div>
                    <br>
                    <a href="@Url.Action("Index", "Home")" type="button" class="btn btn-warning m-t-15 waves-effect">Cancel</a>
                    <button type="submit" class="btn btn-primary m-t-15 waves-effect pull-right">Save</button>
                }
            </div>
        </div>
    </div>
</div>
