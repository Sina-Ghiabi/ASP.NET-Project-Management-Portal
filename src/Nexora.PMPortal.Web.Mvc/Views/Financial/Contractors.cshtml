@using Nexora.PMPortal.Web.Startup

@*@{
        ViewBag.CurrentPageName = PageNames.Projects; // The menu item will be active for this page.
    }*@

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <div class="row">
                    <div class="col-md-4">
                        <h2>
                            Contractors
                        </h2>
                    </div>
                    @if (IsGranted("PmPortal.Contractor.Create"))
                    {
                        <div class="col-md-8">
                            <a href="javascript:;" data-toggle="modal" data-target="#addContractorModal" class="btn btn-primary btn-create  pull-right">Add New Contractor</a>
                        </div>
                    }

                </div>

            </div>
            <div class="body table-responsive">
                <div class="k-rtl">
                    @(Html.Kendo().Grid<Nexora.PMPortal.Web.ViewModels.ContractorViewModel>()
                                                                   .Name("Grid")
                                                                   .Columns(columns =>
                                                                   {
                                                                       columns.Bound(c => c.Id).Filterable(false).Title("#").Width(70);
                                                                       columns.Bound(c => c.Name).Title("Title").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                                                                       columns.Bound(c => c.Code).Title("Code").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains))).Width(150);
                                                                       columns.Command(c => c.Custom("Edit").Click("onEdit").Visible("editPermission")).Width(75);
                                                                       columns.Command(c => c.Destroy().Text("Delete").Visible("destroyPermission")).Width(75);
                                                                   })
                                                                   .Pageable()
                                                                   .Navigatable()
                                                                   .Sortable()
                                                                   .Filterable(ftb => ftb.Mode(GridFilterMode.Row))
                                                                   .Scrollable()
                                                                   .DataSource(dataSource => dataSource
                                                                       .Ajax()
                                                                       .PageSize(10)
                                                                       .ServerOperation(false)
                                                                       .Model(model =>
                                                                       {
                                                                           model.Id(p => p.Id);
                                                                       })
                                                                       .Read(read => read.Action("ContractorRead", "Financial"))
                                                                       .Destroy(destroy => destroy.Action("ContractorDestroy", "Financial"))
                                                                   )
                    )
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    function onEdit(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        $("#id_field").val(dataItem.id);
        $("#name_field").val(dataItem.Name);
        $("#code_field").val(dataItem.Code);
        $('#addContractorModal').modal('show');

    }

   
    function editPermission() {
        return abp.auth.isGranted("PmPortal.Contractor.Edit");
    }

    function destroyPermission() {
        return abp.auth.isGranted("PmPortal.Contractor.Delete");
    }
</script>


<div class="modal fade" id="addContractorModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="AddContractorForm" asp-action="AddContractor" asp-controller="Financial" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h4 class="modal-title" id="defaultModalLabel">Add New Contractor</h4>
                </div>
                <hr />
                <input type="hidden" name="Id" id="id_field" value="" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <label for="">Title</label>
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" class="form-control" id="name_field" name="Name" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label for="">Code</label>
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" class="form-control" id="code_field" name="Code" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success m-t-15 m-r-15 waves-effect pull-right">Save</button>
                    <a data-dismiss="modal" class="btn btn-warning m-t-15 waves-effect pull-right">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $("#AddContractorForm").submit(function (e) {
        e.preventDefault();
        var formAction = $(this).attr("action");

        var fdata = new FormData(this);
        $.ajax({
            type: 'post',
            url: formAction,
            data: fdata,
            enctype: 'multipart/form-data',
            processData: false,
            contentType: false
        }).done(function (result) {
            if (result.status === "success") {
                $('#addContractorModal').modal('hide');
                $('#AddContractorForm').trigger("reset");
                $('#Grid').data('kendoGrid').dataSource.read();
                $('#Grid').data('kendoGrid').refresh();
            } else {
                alert(result.message);
            }
        });
    });
</script>