@using Nexora.PMPortal.Web.Startup
@{
    ViewBag.CurrentPageName = PageNames.PaymentRequests; // The menu item will be active for this page.
}
<style>
    .k-grid td {
        white-space: nowrap;
        text-overflow: ellipsis;
    }
</style>
<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <div class="row">
                    <div class="col-md-4">
                        <h2>
                            Project Managers Approval Queue
                        </h2>
                    </div>

                    <div class="col-md-8">
                        <a href="@Url.Action("PaymentRequests", "Financial")" class="btn btn-warning btn-create  pull-right">Back to Requests List</a>

                    </div>

                </div>

            </div>
            <div class="body">
                <div class="row">
                    <div class="col-md-3">
                        @Html.DropDownList("ProjectId", new SelectList(ViewBag.ProjectId, "Id", "Title"), "-- Select Project --", new { @class = "form-control", data_live_search = "true", multiple = "true", data_title = "-- Select Project --" })
                    </div>
                    <div class="col-md-3">
                        @Html.DropDownList("CurrencyId", Html.GetEnumSelectList(typeof(CurrencyType)), "-- Select Currency --", new { @class = "form-control", required = "required", multiple = "true", data_title = "-- Select Currency --" })
                    </div>
                    <div class="col-md-3">
                        @Html.DropDownList("PaymentRequestTypeId", Html.GetEnumSelectList(typeof(PaymentRequestType)), "-- Select Category --", new { @class = "form-control", required = "required", multiple = "true", data_title = "-- Select Category --" })
                    </div>
                    <div class="col-md-3">
                        @Html.DropDownList("PaymentTypeId", Html.GetEnumSelectList(typeof(PaymentType)), "-- Select Method --", new { @class = "form-control", required = "required", multiple = "true", data_title = "-- Select Method --" })
                    </div>
                    <div class="col-md-3">
                        <select id="SortType" class="form-control">
                            <option value="">-- Sort --</option>
                            <option value="1">Registration Time (Descending)</option>
                            <option value="2">Registration Time (Ascending)</option>
                            <option value="3">Amount (Descending)</option>
                            <option value="4">Amount (Ascending)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb0">
                            <div class="form-line">
                                <input type="text" class="form-control" id="Payto" placeholder="Payable To" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb0">
                            <div class="form-line">
                                <input type="text" class="form-control simple-datepicker" id="FromDate" placeholder="From Date" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb0">
                            <div class="form-line">
                                <input type="text" class="form-control simple-datepicker" id="ToDate" placeholder="To Date" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb0">
                            <div class="form-line">
                                <input type="text" class="form-control" id="RefrenceId" placeholder="Document ID" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb0">
                            <div class="form-line">
                                <input type="text" class="form-control" id="FourthLevel" placeholder="Fourth Level Code" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb0">
                            <div class="form-line">
                                <input type="text" class="form-control simple-datepicker" id="ChequeDueDate" placeholder="Cheque Date" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb0">
                            <div class="form-line">
                                <input type="text" class="form-control" id="PaymentRequestCode" placeholder="Payment Request ID" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <a href="javascript:;" id="Filter" class="btn btn-primary">Apply Filter</a>
                        <a href="javascript:;" id="Excel" class="btn btn-success">Get Excel</a>
                        <a href="javascript:;" id="Filter-Columns" class="btn btn-info">Select Columns</a>
                    </div>
                </div>
                <div class="k-rtl table-responsive">
                    @(Html.Kendo().Grid<Nexora.PMPortal.Web.ViewModels.PaymentRequestViewModel>
                        ()
                        .Name("PaymentRequestsGrid")
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.Id).Title("#").Filterable(false);
                            columns.Bound(c => c.ProjectName).Title("Project").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.Amount).Title("Requested Amount").ClientTemplate("#=priceFormatter(data.Amount)#").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.PaidAmount).Title("Allocated").ClientTemplate("#=priceFormatter(data.PaidAmount)#").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.PaymentType).Title("Payment Method").Hidden().Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.PaymentDescription).Title("Payment Description").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.PayTo).Title("Payable To").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.PaymentRequestCode).Title("Payment Request ID").Hidden().Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.ChequeDueDate).Title("Cheque Date").Hidden().Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.CurrencyType).Title("Currency").Hidden().Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.ScheduleRow).Title("Schedule Row").Hidden().Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.FourthLevelCode).Title("Fourth Level Code").Hidden().Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.Description).Title("Description").Hidden().Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Bound(c => c.CreationDate).Title("Registration Date").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                            columns.Command(c => c.Custom("M").Click("onDetails")).Width(70);
                            columns.Command(c => c.Custom("Approve Request").Click("onConfirm").Visible("confirmPermission")).Width(100);
                            columns.Command(c => c.Custom("Reject Request").Click("onDecline").Visible("declinePermission")).Width(100);
                            columns.Command(c => c.Custom("Edit").Click("onEdit").Visible("editPermission")).Width(65);
                        })
                        .Pageable()
                        .Events(events => events.DataBound("onDataBound"))
                        .DataSource(dataSource => dataSource
                        .Ajax()
                        .PageSize(10)
                        .ServerOperation(true)
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                        })
                        .Events(events => events.RequestEnd("onMasterRequestEnd"))
                        .Read(read => read.Action("PaymentRequestRead", "Financial").Data("additionalInfo"))
                        .Destroy(destroy => destroy.Action("PaymentRequestDestroy", "Financial"))
                        )
                    )
                </div>
                <div class="row clearfix">
                    <div class="col-lg-12 col-md-3 col-sm-6 col-xs-12">
                        <table class="table table-bordered sub-total">
                            <tr>
                                <td width="400">Total Requests:</td>
                                <td id="ResultTotalAmount" class="text-left">0</td>
                                <td width="300">Total Credit Balance:</td>
                                <td id="ResultCreditBalanceTotal" class="text-left">0</td>
                                <td width="400">Total Allocated:</td>
                                <td id="ResultPaidTotalAmount" class="text-left">0</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="addPaymentRequestModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title" id="defaultModalLabel">Payments</h4>
            </div>
            <hr />

            <div class="modal-body">
                <div id="PaymentRequestTransactionsWrapper"></div>
            </div>

            <div class="modal-footer">
                <a data-dismiss="modal" class="btn btn-warning m-t-15 waves-effect pull-right">Close</a>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="LastPageId" value="@ViewBag.LastPageValue" />


<script>
    var pageSet = false;
    function onDataBound(arg) {
        if (!pageSet) {
            $('#PaymentRequestsGrid').data().kendoGrid.dataSource.page($("#LastPageId").val());
            pageSet = true;
        }
    }

    $(document).ready(function () {
        RunFilter(false);
    });

    $("#Filter").click(function () {
        RunFilter(true);
    });

    $("#Excel").click(function () {
        $('#PaymentRequestsGrid').data('kendoGrid').dataSource.page(1);
        $('#PaymentRequestsGrid').data('kendoGrid').refresh();
        var url = "paymentRequestCode=" + $("#PaymentRequestCode").val() +
            "&chequeDueDate=" + $("#ChequeDueDate").val() +
            "&fourthLevelCode=" + $("#FourthLevel").val() +
            "&selectedProjectId=" + $("#ProjectId").val() +
            "&currencyId=" + $("#CurrencyId").val() +
            "&paymentRequestType=" + $("#PaymentRequestTypeId").val() +
            "&PaymentType=" + $("#PaymentTypeId").val() +
            "&payto=" + $("#Payto").val() +
            "&from=" + $("#FromDate").val() +
            "&to=" + $("#ToDate").val() +
            "&sortType=" + $("#SortType").val() +
            "&id=" + $("#RefrenceId").val() +
            "&paymentRequestStatus=" + 1;
        window.location = "/Financial/PaymentRequestExcel?" + url;
    });

    function RunFilter(isFilterBtn) {
        if (isFilterBtn) {
            $('#PaymentRequestsGrid').data('kendoGrid').dataSource.page(1);
            $('#PaymentRequestsGrid').data('kendoGrid').refresh();
        }
        else {
            $('#PaymentRequestsGrid').data('kendoGrid').dataSource.read();
            $('#PaymentRequestsGrid').data('kendoGrid').refresh();
        }
        $.ajax({
            type: "GET",
            url: "/Financial/PaymentRequestFilterResult",
            traditional: true,
            data: {
                paymentRequestCode: $("#PaymentRequestCode").val(),
                chequeDueDate: $("#ChequeDueDate").val(),
                fourthLevelCode: $("#FourthLevel").val(),
                selectedProjectId: $("#ProjectId").val(),
                currencyId: $("#CurrencyId").val(),
                paymentRequestType: $("#PaymentRequestTypeId").val(),
                PaymentType: $("#PaymentTypeId").val(),
                payto: $("#Payto").val(),
                from: $("#FromDate").val(),
                to: $("#ToDate").val(),
                sortType: $("#SortType").val(),
                id: $("#RefrenceId").val(),
                paymentRequestStatus: 1
            },
            success: function (response) {
                $("#ResultTotalAmount").html(response.total);
                $("#ResultCreditBalanceTotal").html(response.totalCredit);
                $("#ResultPaidTotalAmount").html(response.totalPaid);
            },
            failure: function (response) {
                alert(response);
            }
        });
    }

    function additionalInfo() {
        return {
            paymentRequestCode: $("#PaymentRequestCode").val(),
            chequeDueDate: $("#ChequeDueDate").val(),
            fourthLevelCode: $("#FourthLevel").val(),
            selectedProjectId: $("#ProjectId").val(),
            currencyId: $("#CurrencyId").val(),
            paymentRequestType: $("#PaymentRequestTypeId").val(),
            PaymentType: $("#PaymentTypeId").val(),
            payto: $("#Payto").val(),
            from: $("#FromDate").val(),
            to: $("#ToDate").val(),
            sortType: $("#SortType").val(),
            id: $("#RefrenceId").val(),
            paymentRequestStatus: 1
        };
    }

    function onEdit(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var pageId = $("#PaymentRequestsGrid").data("kendoGrid").dataSource.page();

        if (dataItem.PaymentsCount > 0) {
            swal("Operation Error", "Requests with finalized payments cannot be edited!", "warning");
        }
        else {
            window.location.href = "/Financial/EditPaymentRequest/" + dataItem.id + "?lastPage=" + pageId + "&referer=QueueOnePaymentRequests";

        }
    }


    function onTransactions(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));

        $.ajax({
            type: "GET",
            url: "/Financial/PaymentRequestTransaction?id=" + dataItem.id,
            success: function (response) {
                var dvItems = $("#PaymentRequestTransactionsWrapper");
                dvItems.empty();
                dvItems.html(response);
                $('#addPaymentRequestModal').modal('show');
            },
            failure: function (response) {
                alert(response);
            }
        });


    }

    function onRequestEnd(e) {
        var operationType = e.type;

        if (operationType == "destroy") {
            $('#PaymentRequestsGrid').data('kendoGrid').dataSource.read();
            $('#PaymentRequestsGrid').data('kendoGrid').refresh();
        }
    }

    //function transactionPermission() {
    //    return abp.auth.isGranted("PmPortal.Liquidity.PaymentRequests.Transactions");
    //}

    function editPermission() {
        return abp.auth.isGranted("PmPortal.Liquidity.PaymentRequests.QueueOne.Edit");
    }

    function confirmPermission() {
        return abp.auth.isGranted("PmPortal.Liquidity.PaymentRequests.QueueOne.Confirm");
    }

    function declinePermission() {
        return abp.auth.isGranted("PmPortal.Liquidity.PaymentRequests.QueueOne.Decline");
    }

    function onConfirm(e) {

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        swal("Are you sure you want to approve this request?", {
            buttons: {
                cancel: "No",
                confirm: {
                    text: "Yes, approve it!",
                    value: "confirm",
                }
            },
        })
            .then((value) => {
                switch (value) {
                    case "confirm":

                        $.ajax({
                            url: '/Financial/PaymentRequestChangeStatus',
                            data: { "paymentRequestId": dataItem.id, "status": 2 },
                            method: "POST",
                            success: function (data) {
                                if (data.status == "success") {
                                    RunFilter(false);
                                }
                                else {
                                    swal("System Error", "Approving the request failed!", "error");
                                }
                            },
                            error: function (response) {
                                swal("System Error", "Approving the request failed!", "error");
                            }
                        });

                        break;
                }
            });


    }


    function onDecline(e) {

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        swal("Are you sure you want to reject this request?", {
            buttons: {
                cancel: "No",
                confirm: {
                    text: "Yes, reject it!",
                    value: "decline",
                }
            },
        })
            .then((value) => {
                switch (value) {
                    case "decline":

                        $.ajax({
                            url: '/Financial/PaymentRequestChangeStatus',
                            data: { "paymentRequestId": dataItem.id, "status": 10 },
                            method: "POST",
                            success: function (data) {
                                if (data.status == "success") {
                                    RunFilter(false);
                                }
                                else {
                                    swal("System Error", "Rejecting the request failed!", "error");
                                }
                            },
                            error: function (response) {
                                swal("System Error", "Rejecting the request failed!", "error");
                            }
                        });

                        break;
                }
            });


    }

    function onDetails(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        $("#Details_PaymentRequestCode").html(dataItem.PaymentRequestCode);
        $("#Details_ChequeDueDate").html(dataItem.ChequeDueDate);
        $('#itemDetails').modal('show');
    }


</script>

<script>
    function onMasterRequestEnd(e) {
        var operationType = e.type;
        if (operationType == "destroy") {
            if (e.response.errors) {
                if (e.response.errors.DependentRecord) {
                    swal("System Error", "This item cannot be deleted until all its payments are deleted!", "error");
                    var grid = $("#PaymentRequestsGrid").data("kendoGrid");
                    grid.cancelChanges();
                }
            }
        }

    }

</script>





<div class="modal fade" id="editItem" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="editTransactionForm" asp-action="EditTransaction" asp-controller="Financial" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    @*<h4 class="modal-title" id="modal_project_title"></h4>*@
                </div>
                <hr />
                <input type="hidden" id="modal_id" name="modal_id" value="" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <label for="">Amount</label>
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" class="form-control" id="modal_amount" name="modal_amount" data-inputmask="'alias': 'decimal', 'groupSeparator': ','" inputmode="numeric" required="required" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label for="">Date</label>
                            <div class="form-group">
                                <div class="form-line">
                                    <input type="text" class="form-control simple-datepicker" id="modal_date" name="modal_date" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success m-t-15 m-r-15 waves-effect pull-right">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    $("#editTransactionForm").submit(function (e) {
        e.preventDefault();
        if ($(this).valid()) {
            var formAction = $(this).attr("action");
            var fdata = new FormData(this);
            $.ajax({
                type: 'post',
                url: formAction,
                data: fdata,
                enctype: 'multipart/form-data',
                processData: false,
                contentType: false
            }).done(function (result) {
                if (result.status === "success") {
                    $('#editItem').modal('hide');
                    $('#editTransactionForm').trigger("reset");
                    $('#PaymentTransactionGrid').data('kendoGrid').dataSource.read();
                    $('#PaymentTransactionGrid').data('kendoGrid').refresh();
                } else {
                    alert(result.message);
                }
            });
        }
    });
</script>


<div class="modal fade" id="itemDetails" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <table class="table table-striped">
                <tr>
                    <td>Cheque Date</td>
                    <td id="Details_ChequeDueDate"></td>
                </tr>
                <tr>
                    <td>Payment Request ID</td>
                    <td id="Details_PaymentRequestCode"></td>
                </tr>
            </table>
        </div>
    </div>
</div>


<script>
    $("#Filter-Columns").click(function () {
        window.location.href = "/Financial/QueueOne_EditChosenColumns" + "?TableID=" + 4;
    });
</script>

