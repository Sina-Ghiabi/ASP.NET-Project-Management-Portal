@model Nexora.PMPortal.Web.ViewModels.ReceiveBillViewModel

@{
    ViewBag.CurrentPageName = PageNames.ReceiveBills; // The menu item will be active for this page.
}
<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <div class="row">
                    <div class="col-md-4">
                        <h2>
                            Register New Receipt
                        </h2>
                    </div>
                    <div class="col-md-8">
                    </div>
                </div>

            </div>
            <div class="body">

                @using (Html.BeginForm("AddReceiveBill", "Financial", FormMethod.Post, new { @class = "", role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            <label for="">Project</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.DropDownList("ProjectId", new SelectList(ViewBag.ProjectId, "Id", "Title"), "-- Select Project --", new { @class = "form-control", required = "required", data_live_search = "true" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Receipt Type</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.DropDownListFor(model => model.ReceiveBillType, Html.GetEnumSelectList(typeof(ReceiveBillType)), "--- Select ---", new { @class = "form-control", required = "required" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Receipt Date</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.ReceiveDate, new { @class = "form-control simple-datepicker", placeholder = "", autocomplete = "off" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">

                        <div class="col-md-6">
                            <label for="">Amount</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", placeholder = "", required = "required", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Currency</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.DropDownListFor(model => model.CurrencyType, Html.GetEnumSelectList(typeof(CurrencyType)), new { @class = "form-control", required = "required" })
                                </div>
                            </div>
                        </div>
                    </div>


                    <label for="">Description</label>
                    <div class="form-group">
                        <div class="form-line">
                            @Html.TextAreaFor(model => model.ReceiveDescription, new { @class = "form-control", placeholder = "", row = "3" })
                        </div>
                    </div>
                    <label for="">Note</label>
                    <div class="form-group">
                        <div class="form-line">
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", placeholder = "", row = "3" })
                        </div>
                    </div>
                    <br>
                    <a href="@Url.Action("ReceiveBills", "Financial")" type="button" class="btn btn-warning m-t-15 waves-effect">Cancel</a>
                    <button type="submit" class="btn btn-primary m-t-15 waves-effect pull-right">Save</button>
                }
            </div>
        </div>
    </div>
</div>
