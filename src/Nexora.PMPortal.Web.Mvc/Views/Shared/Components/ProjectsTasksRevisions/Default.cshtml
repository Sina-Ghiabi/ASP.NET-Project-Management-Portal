<script>
    //Send TaskID To ProjectsTasks.cshtml File
    $(document).ready(function () {
        var ProjectCode = '@Html.Raw(Model.ProjectCode)';
        var TaskID = '@Html.Raw(Model.TaskID)';
        var DocumentNumber = '@Html.Raw(Model.DocumentNumber)';
        var DocumentTitle = '@Html.Raw(Model.DocumentTitle)';

        //Pages Title
        $("#Title").text('@Html.Raw(Model.DocumentTitle)');

        //AddRevisions Form's Data - Return To Same Revision Page
        $("#ProjectCode-AddRevision").val(ProjectCode);
        $("#TaskID-AddRevision").val(TaskID);
        $("#DocumentNumber-AddRevision").val(DocumentNumber);
        $("#DocumentTitle-AddRevision").val(DocumentTitle);

        //AddRevisionsFromKatibeh Form's Data - Return To Same Revision Page
        $("#ProjectCode-AddRevisionFromKatibeh").val(ProjectCode);
        $("#TaskID-AddRevisionFromKatibeh").val(TaskID);
        $("#DocumentNumber-AddRevisionFromKatibeh").val(DocumentNumber);
        $("#DocumentTitle-AddRevisionFromKatibeh").val(DocumentTitle);

        //ChosenColumns Form's Data - Return To Same Revision Page
        $("#TableID-ChosenColumns").val(7);
        $("#ProjectCode-ChosenColumns").val(ProjectCode);
        $("#TaskID-ChosenColumns").val(TaskID);
        $("#DocumentNumber-ChosenColumns").val(DocumentNumber);
        $("#DocumentTitle-ChosenColumns").val(DocumentTitle);

        //Pass OnRevisionEdit Values To ProjectsTasks Inputs - Return To Same Revision Page
        $("#ModalProjectCode").val(ProjectCode);
        $("#ModalTaskID").val(TaskID);
        $("#ModalDocumentNumber").val(DocumentNumber);
        $("#ModalDocumentTitle").val(DocumentTitle);
    });

    $("#NewRevision").click(function () {
        $("#Form-AddRevisions").submit();
    });

    $("#NewRevisionFromKatibeh").click(function () {
        $("#Form-AddRevisionsFromKatibeh").submit();
    });
</script>

