        var fdata = new FormData(this);

        var fileInput = $('#AssetFileInput')[0];
        var files = fileInput.files[0];
        fdata.append("file", files);

        $.ajax({
            type: 'post',
            url: formAction,
            data: fdata,
            enctype: 'multipart/form-data',
            processData: false,
            contentType: false
        }).done(function (result) {
            if (result.status === "success") {
                location.reload();
                $('#addProjectAssetModal').modal('hide');
                $('#addProjectAssetForm').trigger("reset");
            } else {
                alert(result.message);
            }
        });
