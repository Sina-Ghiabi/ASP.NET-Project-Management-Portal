                            function editStatement_Permission() {
                                return abp.auth.isGranted("PmPortal.Project.FinancialStatement.Edit");
                            }
                            function destroyStatement_Permission() {
                                return abp.auth.isGranted("PmPortal.Project.FinancialStatement.Delete");
                            }
