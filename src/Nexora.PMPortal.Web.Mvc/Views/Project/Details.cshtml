<div class="modal fade" id="addFinancialStatementModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="FinancialStatementFormWrapper">

        </div>
    </div>
</div>


<script>
    $("#addProjectFinancialStatement").click(function () {
        generateFinancialStatementForm("");
    });

    function onProjectFinancialStatementEdit(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        generateFinancialStatementForm(dataItem.id);
    }

    function generateFinancialStatementForm(id) {
        $.ajax({
            type: "GET",
            url: "/Project/OpenFinancialStatementForm?id=" + id + "&projectId=" + $("#ProjectId").val(),
            success: function (response) {
                var dvItems = $("#FinancialStatementFormWrapper");
                dvItems.empty();
                dvItems.html(response);
                $('#addFinancialStatementModal').modal('show');
            },
            failure: function (response) {
                alert(response);
            }
        });
    }

    function onFinancialStatementDownload(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        if (dataItem.FileUrl) {
            window.open(
                dataItem.FileUrl,
                '_blank' // <- This is what makes it open in a new window.
            );
        }
        else {
            alert("No file available");
        }

    }
</script>


