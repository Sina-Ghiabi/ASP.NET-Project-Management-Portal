<script>
    const ProjectID = document.URL.split('Details/').pop();
    var Coefficient = 1;
    var Start = 50;
    var End = 65;
    var List = []; //If Data Exists in List Do Nothing

    //After Page Compiled , Load The First 50 Pictures
    $(document).ready(function () {
        $.ajax({
            type: "POST",
            data: { 'ID': ProjectID, 'Start': 0, 'End': 50 },
            url: "/Project/ProjectMediaAjax",
            dataType: 'JSON',
            success: function (response) {
                for (var Index = 0; Index <= Object.keys(response).length; Index++) {

                    $('#lightgallery').append('<div class="LightGallery col-lg-2 col-md-2 col-sm-6 col-xs-6" data-src="' + response[Index].ImageUrl + '" data-sub-html="<h2> ' + response[Index].SubmitDate + ' - ' + response[Index].Title + '</h2>">\
                                                      <a data-src="'+ response[Index].ImageUrl + '">\
                                                           <img class="LightGallery img-responsive thumbnail" src="'+ response[Index].ImageUrl + '">\
                                                      </a>\
                                                      <span class="gallery-img-date">'+ response[Index].SubmitDate + '</span>\
                                                </div>\
                                              ');
                }
            },
            failure: function () {
                alert("No data available");
            }
        });
    });



    $('#GalleryButton').click(function () {

        ScrollEvent("ON");
        //$('#lightgallery').lightGallery(); //This Part Of Code Is For Slider - Should Not Move From Here - It Just Works Here
        $('#lightgallery').lightGallery();

    });

    $('#FinancialStatementButton,#BasicInfoButton,#ReportsButton,#PlansButton,#FinancialButton,#AddPictureButton').click(function () {

        ScrollEvent("OFF");

    });

    function ScrollEvent(Event) {

        if (Event == "ON") {

            $(window).on('scroll', function (event) {

                var ScrollFromTop = $(document).scrollTop(); // This Part Of Code Should Not Move From Here

                if (ScrollFromTop >= 400 * Coefficient) {

                    if ($.inArray(ScrollFromTop, List) == -1) {

                        //Didn't Find ScrollPoint In List

                        List.push(ScrollFromTop); //Add Point To List If Scroll Reached That Point - Then Check If Already Reached That Point To Prevent Loading Pictures Again

                        $.ajax({
                            type: "POST",

                            data: { 'ID': ProjectID, 'Start': Start, 'End': End },

                            url: "/Project/ProjectMediaAjax",
                            dataType: 'JSON',
                            success: function (response) {
                                for (var Index = 0; Index <= Object.keys(response).length; Index++) {

                                    $('#lightgallery').append('<div class="col-lg-2 col-md-2 col-sm-6 col-xs-6" data-src="' + response[Index].ImageUrl + '" data-sub-html="<h2> ' + response[Index].SubmitDate + ' - ' + response[Index].Title + '</h2>">\
                                                      <a data-src="'+ response[Index].ImageUrl + '">\
                                                           <img class="img-responsive thumbnail" src="'+ response[Index].ImageUrl + '">\
                                                      </a>\
                                                      <span class="gallery-img-date">'+ response[Index].SubmitDate + '</span>\
                                                </div>\
                                              ');
                                    //Every Time That New Group Of Pictures Has Been Read From Database We Must Destroy The Last Gallery And Create New One
                                    $("#lightgallery").data("lightGallery").destroy(true);
                                    $('#lightgallery').lightGallery(); 
                                }
                            },

                            failure: function () {
                                alert("No data available");
                            }

                        });
                        Coefficient++;
                        Start = Start + 15;
                        End = End + 15;
                    }
                }
            })

        } else if (Event == "OFF") {

            $(window).off('scroll'); //It Turns Off The  $(window).on('DOMMouseScroll mousewheel', function (event) {... } EventHandler At Top After It Clicked On Any Other Button Except GalleryButton

        }
    }

</script>
