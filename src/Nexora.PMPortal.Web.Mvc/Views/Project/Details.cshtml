    $("#RemoveAssetFile").click(function (e) {
        e.preventDefault();

        $.ajax({
            type: 'post',
            url: '/Project/DeleteAssetFile',
            data: { projectId: $("#ProjectId").val() },
        }).done(function (result) {
            if (result.status === "success") {
                location.reload();
            } else {
                alert(result.message);
            }
        });
    });



</script>

