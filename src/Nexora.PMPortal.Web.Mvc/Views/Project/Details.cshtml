                </div>
                <hr />
                @Html.HiddenFor(model => model.ProjectMediaForm.ProjectId)
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <label for="">Title</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.ProjectMediaForm.Title, new { @class = "form-control", placeholder = "", autocomplete = "off" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Date</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.ProjectMediaForm.SubmitDate, new { @class = "form-control simple-datepicker", placeholder = "", autocomplete = "off" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">File</label>
                            <div class="form-group">
                                <div class="form-line">
                                    <input id="ProjectMediaInput" name="ProjectMediaInput" type="file" class="m-t-15" multiple />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success m-t-15 m-r-15 waves-effect pull-right">Submit</button>
                    <a data-dismiss="modal" class="btn btn-warning m-t-15 waves-effect pull-right">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $("#addProjectMediaForm").submit(function (e) {
        e.preventDefault();
        console.log('Doing ajax submit');
        var formAction = $(this).attr("action");

        var fdata = new FormData(this);

        //var fileInput = $('#ProjectMediaInput')[0];
        //var files = fileInput.files[0];
        //fdata.append("files", files);

        if ($('#ProjectMediaInput')[0].files.length > 10) {
            alert("Maximum number of files is 10!");
            return;
        }

        $.each($('#ProjectMediaInput')[0].files, function (i, file) {
            fdata.append('files', file);
        });

        $.ajax({
            type: 'post',
            url: formAction,
            data: fdata,
            enctype: 'multipart/form-data',
            processData: false,
            contentType: false
        }).done(function (result) {
            if (result.status === "success") {
                $('#addProjectMediaModal').modal('hide');
                $('#addProjectMediaForm').trigger("reset");
                $('#ProjectMediaGrid').data('kendoGrid').dataSource.read();
                $('#ProjectMediaGrid').data('kendoGrid').refresh();
            } else {
                alert(result.message);
            }
        });
    });

    function onProjectMediaDownload(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        if (dataItem.ImageUrl) {
            window.open(
                dataItem.ImageUrl,
                '_blank' // <- This is what makes it open in a new window.
            );
        }
        else {
            alert("No file available");
        }

    }
</script>

