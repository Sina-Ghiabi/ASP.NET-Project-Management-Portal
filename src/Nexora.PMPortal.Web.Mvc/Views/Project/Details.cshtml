@model Nexora.PMPortal.Web.ViewModels.ProjectViewModel
@{
    ViewData["Title"] = "Create";
}
<script src="https://cdn.jsdelivr.net/picturefill/2.3.1/picturefill.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-mousewheel/3.1.13/jquery.mousewheel.min.js"></script>
<script src="~/lib/lightgallery/js/lightgallery-all.min.js"></script>

<link href="~/lib/lightgallery/css/lightgallery.css" rel="stylesheet" />


<style>
    .gallery-img-date {
        background: #000167;
        width: 100%;
        display: inline-block;
        color: #fff;
        text-align: center;
        padding: 6px;
        margin-top: -5px;
    }
</style>
<input type="hidden" id="ProjectId" value="@Model.Id" />
<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <div class="row">
                    <div class="col-md-4">
                        <h2>
                            Project Details - @Model.Title
                        </h2>
                    </div>
                    <div class="col-md-8">
                        <a href="@Url.Action("Index","Project")" class="btn btn-warning btn-create  pull-right">Back to Projects List</a>
                    </div>
                </div>

            </div>
            <div class="body">

                <!-- Nav tabs -->
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a id="BasicInfoButton" href="#home_with_icon_title" data-toggle="tab">
                            <i class="material-icons">home</i> Basic Info
                        </a>
                    </li>
                    @if (IsGranted("PmPortal.Project.FinancialStatement"))
                    {
                        <li role="presentation">
                            <a id="FinancialStatementButton" href="#profile_with_icon_title" data-toggle="tab">
                                <i class="material-icons">assignment</i> Financial Statements
                            </a>
                        </li>
                    }
                    @if (IsGranted("PmPortal.Project.ProjectReport"))
                    {
                        <li role="presentation">
                            <a id="ReportsButton" href="#messages_with_icon_title" data-toggle="tab">
                                <i class="material-icons">assignment_turned_in</i> Reports
                            </a>
                        </li>
                    }
                    @if (IsGranted("PmPortal.Project.ProjectPlan"))
                    {
                        <li role="presentation">
                            <a id="PlansButton" href="#ProjectPlanSection" data-toggle="tab">
                                <i class="material-icons">assignment_turned_in</i> Plans
                            </a>
                        </li>
                    }
                    @if (IsGranted("PmPortal.Project.ProjectAsset"))
                    {
                        <li role="presentation">
                            <a id="FinancialButton" href="#assets_with_icon_title" data-toggle="tab">
                                <i class="material-icons">dns</i> Assets
                            </a>
                        </li>
                    }
                    @if (IsGranted("PmPortal.Project.ProjectMedia"))
                    {
                        <li role="presentation">
                            <a id="AddPictureButton" href="#settings_with_icon_title" data-toggle="tab">
                                <i class="material-icons">photo_library</i> Images
                            </a>
                        </li>
                    }
                    @if (IsGranted("PmPortal.Project.ProjectGallery"))
                    {
                        <li role="presentation">
                            <a id="GalleryButton" href="#settings_with_icon_title1" data-toggle="tab">
                                <i class="material-icons">photo_library</i> Gallery
                            </a>
                        </li>
                    }
                </ul>

                <!-- Tab panes -->
                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane fade in active p-t-10" id="home_with_icon_title">
                        <table class="table table-striped">
                            <tr>
                                <th>Title</th>
                                <td>@Model.Title</td>
                                <th>Project Code</th>
                                <td>@(Model.Code ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Project Type</th>
                                <td>@Model.ProjectType.GetDisplayName()</td>
                                <th>Project Status</th>
                                <td>@Model.ProjectStatus.GetDisplayName()</td>
                            </tr>
                            <tr>
                                <th>Client</th>
                                <td>@(Model.Client ?? "-")</td>
                                <th>Planning Manager</th>
                                <td>@(Model.PlannigManager ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Consultant</th>
                                <td>@(Model.Consultant ?? "-")</td>
                                <th>Project Manager</th>
                                <td>@(Model.ProjectManager ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Partners</th>
                                <td>@(Model.Partners ?? "-")</td>
                                <th>Partnership Percentage</th>
                                <td>@(Model.PartnerShares ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Initial Amount (Rial)</th>
                                <td>@(Model.InitialContractAmount ?? "-")</td>
                                <th>Extension Amount (Rial)</th>
                                <td>@(Model.ExtensionContractAmount ?? "-")</td>
                            </tr>
                            @if (Model.AmountCurrencyType != null)
                            {
                                <tr>
                                    <th>Initial Amount (@Model.AmountCurrencyType.GetDisplayName())</th>
                                    <td>@(Model.InitialContractAmountInCurrency ?? "-")</td>
                                    <th>Extension Amount (@Model.AmountCurrencyType.GetDisplayName())</th>
                                    <td>@(Model.ExtensionContractAmountInCurrency ?? "-")</td>
                                </tr>
                            }
                            <tr>
                                <th>Project Location</th>
                                <td>@(Model.ProjectSite ?? "-")</td>
                                <th>Start Date</th>
                                <td>@(Model.StartDate ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Temporary Delivery Date</th>
                                <td>@(Model.TemporaryDeliveryDate ?? "-")</td>
                                <th>Final Delivery Date</th>
                                <td>@(Model.FinalDeliveryDate ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Contract Duration</th>
                                <td>@(Model.ProjectContractPeriod)</td>
                                <th>Contract End Date</th>
                                <td>@(Model.ContractEndDate ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Last Adjustment Statement</th>
                                <td>@(Model.LastAdjustmentFinancialStatemntValue ?? "-")</td>
                                <th>Last Temporary Statement</th>
                                <td>@(Model.LastTemporaryFinancialStatemntValue ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td colspan="3">
                                    @(Model.Description ?? "-")
                                </td>
                            </tr>
                        </table>
                    </div>
                    @if (IsGranted("PmPortal.Project.FinancialStatement"))
                    {
                        <div role="tabpanel" class="tab-pane fade  p-t-10" id="profile_with_icon_title">
                            @if (IsGranted("PmPortal.Project.FinancialStatement.Create"))
                            {
                                <button type="button" id="addProjectFinancialStatement" class="btn bg-green waves-effect">
                                    New Financial Statement
                                </button>
                            }
                            <div class="k-rtl m-t-20">
                                @(Html.Kendo().Grid<Nexora.PMPortal.Web.ViewModels.FinancialStatementViewModel>()
                                                                                                                                                                                                  .Name("FinancialStatementGrid")
                                                                                                                                                                                                  .Columns(columns =>
                                                                                                                                                                                                  {
                                                                                                                                                                                                      columns.Bound(c => c.Id).Filterable(false).Title("#").Width(40);
                                                                                                                                                                                                      columns.Bound(c => c.Number).Title("Number");
                                                                                                                                                                                                      columns.Bound(c => c.FinancialStatementType).Title("Type");
                                                                                                                                                                                                      columns.Bound(c => c.CurrencyType).Title("Currency");
                                                                                                                                                                                                      columns.Bound(c => c.PeriodicAmount).Title("Period Amount");
                                                                                                                                                                                                      columns.Bound(c => c.TotalAmount).Title("Cumulative Amount");
                                                                                                                                                                                                      columns.Bound(c => c.StartDate).Title("Start Date");
                                                                                                                                                                                                      columns.Bound(c => c.EndDate).Title("End Date");
                                                                                                                                                                                                      columns.Command(c => c.Custom("Download File").Click("onFinancialStatementDownload")).Width(85);
                                                                                                                                                                                                      columns.Command(c => c.Custom("Edit").Click("onProjectFinancialStatementEdit").Visible("editStatement_Permission")).Width(85);
                                                                                                                                                                                                      columns.Command(command => { command.Destroy().Text("Delete").Visible("destroyStatement_Permission"); }).Width(92);
                                                                                                                                                                                                  })
                                                                                                                                                                                                  .Pageable()
                                                                                                                                                                                                  .Navigatable()
                                                                                                                                                                                                  .Sortable()
                                                                                                                                                                                                  .Filterable(ftb => ftb.Mode(GridFilterMode.Row))
                                                                                                                                                                                                  .Scrollable()
                                                                                                                                                                                                  .DataSource(dataSource => dataSource
                                                                                                                                                                                                      .Ajax()
                                                                                                                                                                                                      .PageSize(10)
                                                                                                                                                                                                      .ServerOperation(false)
                                                                                                                                                                                                      .Model(model =>
                                                                                                                                                                                                      {
                                                                                                                                                                                                          model.Id(p => p.Id);
                                                                                                                                                                                                      })
                                                                                                                                                                                                      .Read(read => read.Action("FinancialStatementRead", "Project", new { projectId = Model.Id }))
                                                                                                                                                                                                      .Destroy(destroy => destroy.Action("FinancialStatementDestroy", "Project"))
                                                                                                                                                                                                  )
                                )
