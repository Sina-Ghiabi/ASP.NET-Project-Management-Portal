@model Nexora.PMPortal.Web.ViewModels.ChartForm.ProgressPercentageViewModel
@{
    ViewData["Title"] = "Create";
    ViewBag.CurrentPageName = PageNames.ProgressPercentage; // The menu item will be active for this page.
}

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <div class="row">
                    <div class="col-md-4">
                        <h2>
                            Add New Progress Percentage
                        </h2>
                    </div>
                    <div class="col-md-8">
                    </div>
                </div>

            </div>
            <div class="body">

                @using (Html.BeginForm("Create", "ProgressPercentage", FormMethod.Post, new { @class = "", role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6">
                            <label for="">Project</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.DropDownList("ProjectId", new SelectList(ViewBag.ProjectId, "Id", "Title"), "-- Select Project --", new { @class = "form-control", required = "required", data_live_search = "true" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Year</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.DropDownListFor(model => model.Year, Html.GetEnumSelectList(typeof(SelectiveYear)), "--- Select ---", new { @class = "form-control", required = "required" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Month</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.DropDownListFor(model => model.Month, Html.GetEnumSelectList(typeof(SelectiveMonth)), "--- Select ---", new { @class = "form-control", required = "required" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="">Cumulative Planned Engineering Progress %</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.EngineeringProgressPlan, new { @class = "form-control", placeholder = "", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric", required = "required" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Cumulative Actual Engineering Progress %</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.EngineeringProgressReal, new { @class = "form-control", placeholder = "", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric", required = "required" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="">Cumulative Planned Procurement Progress %</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.SupplyProgressPlan, new { @class = "form-control", placeholder = "", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric", required = "required" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Cumulative Actual Procurement Progress %</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.SupplyProgressReal, new { @class = "form-control", placeholder = "", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric", required = "required" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="">Cumulative Planned Execution Progress %</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.ExecutionProgressPlan, new { @class = "form-control", placeholder = "", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric", required = "required" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Cumulative Actual Execution Progress %</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.ExecutionProgressReal, new { @class = "form-control", placeholder = "", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric", required = "required" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="">Cumulative Planned Total Progress %</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.TotalExecutionProgressPlan, new { @class = "form-control", placeholder = "", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric", required = "required" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Cumulative Actual Total Progress %</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.TotalExecutionProgressReal, new { @class = "form-control", placeholder = "", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric", required = "required" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="">Periodic Planned Total Progress %</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.TotalProgressPlan, new { @class = "form-control", placeholder = "", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric", required = "required" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="">Periodic Actual Total Progress %</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.TextBoxFor(model => model.TotalProgressReal, new { @class = "form-control", placeholder = "", data_inputmask = "'alias': 'decimal', 'groupSeparator': ','", inputmode = "numeric", required = "required" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <br>
                    <a href="@Url.Action("Index", "ProgressPercentage")" type="button" class="btn btn-warning m-t-15 waves-effect">Cancel</a>
                    <button type="submit" class="btn btn-primary m-t-15 waves-effect pull-right">Save</button>
                }
            </div>
        </div>
    </div>
</div>
