@using Abp.Authorization.Users
@model Nexora.PMPortal.Web.Models.Users.UserFormViewModel
@{
    ViewBag.CurrentPageName = PageNames.Users;
}

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <div class="row">
                    <div class="col-md-4">
                        <h2>
                            Users
                        </h2>
                    </div>
                    <div class="col-md-8">
                        <a href="@Url.Action("Index","Users")" class="btn btn-warning btn-create  pull-right">Back to User List</a>
                    </div>
                </div>

            </div>
            <div class="body">
                <form method="post" class="form form-vertical">
                    <div class="form-body">
                        <div class="row">
                            <div class="col-md-12">
                                <label for="">Username</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.TextBoxFor(model => model.User.UserName, new { @class = "form-control", placeholder = "" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <label for="">First Name</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.TextBoxFor(model => model.User.Name, new { @class = "form-control", placeholder = "" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <label for="">Last Name</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.TextBoxFor(model => model.User.Surname, new { @class = "form-control", placeholder = "" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <label for="">Email</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.TextBoxFor(model => model.User.EmailAddress, new { @class = "form-control", placeholder = "" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <label for="">Password</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.TextBoxFor(model => model.User.Password, new { @class = "form-control", placeholder = "" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                @Html.CheckBoxFor(model => model.User.IsActive, new { @class = "filled-in chk-col-indigo" })
                                <label for="User_IsActive">Active</label>
                            </div>

                            <div class="form-group">
                                <h4>Roles</h4>
                                <br />
                                @foreach (var item in Model.Roles)
                                {
                                    @Html.CheckBox("SelectedRoles", new {id="Role_" + item.Id, @value = item.Name, @class = "filled-in chk-col-indigo" })
                                    <label for="Role_@item.Id">@item.DisplayName</label>
                                }

                            </div>
                            <div class="col-md-12">
                                <hr />
                                <button type="submit" class="btn btn-primary mr-1 mb-1 waves-effect waves-light">Submit</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>