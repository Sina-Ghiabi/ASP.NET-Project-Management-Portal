@using Nexora.PMPortal.Web.Startup
@model Nexora.PMPortal.Web.ViewModels.ManagerReportViewModel

@{
    ViewBag.CurrentPageName = PageNames.ManagerReports; // The menu item will be active for this page.
}

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="card">
            <div class="header">
                <div class="row">
                    <div class="col-md-4">
                        <h2>
                            Manager Reports
                        </h2>
                    </div>
                    <div class="col-md-8">
                        @if (IsGranted("PmPortal.Reports.ManagerReports.Create"))
                        {
                            if (ViewBag.TypeId == null)
                            {
                                <button data-toggle="modal" data-target="#addManagerReportModal" class="btn btn-primary btn-create  pull-right">Add New Report</button>
                            }
                        }
                        @if (ViewBag.TypeId != null)
                        {
                            <a href="@Url.Action("Index","ManagerReport")" class="btn btn-warning btn-create  pull-right m-r-20">Back to Report Types List</a>
                        }
                    </div>
                </div>

            </div>
            <div class="body table-responsive">
                @if (ViewBag.TypeId != null)
                {
                    <div class="k-rtl">
                        @(Html.Kendo().Grid<Nexora.PMPortal.Web.ViewModels.ManagerReportViewModel>()
                                                                                                    .Name("ManagerReportGrid")
                                                                                                    .Columns(columns =>
                                                                                                    {
                                                                                                        columns.Bound(c => c.Id).Filterable(false).Title("#").Width(40);
                                                                                                        columns.Bound(c => c.Description).Title("Description");
                                                                                                        columns.Bound(c => c.StartDate).Title("Start Date");
                                                                                                        columns.Bound(c => c.EndDate).Title("End Date");
                                                                                                        columns.Bound(c => c.CreationTime).Title("Registration Date");
                                                                                                        columns.Command(c => c.Custom("Download File").Click("onManagerReportDownload")).Width(85);
                                                                                                        columns.Command(c => c.Custom("Edit").Click("onManagerReportEdit").Visible("editManagerReport_Permission")).Width(85);
                                                                                                        columns.Command(command => { command.Destroy().Text("Delete").Visible("destroyPermission"); }).Width(92);
                                                                                                    })
                                                                                                    .Pageable()
                                                                                                    .Navigatable()
                                                                                                    .Sortable()
                                                                                                    .Filterable(ftb => ftb.Mode(GridFilterMode.Row))
                                                                                                    .Scrollable()
                                                                                                    .DataSource(dataSource => dataSource
                                                                                                        .Ajax()
                                                                                                        .PageSize(10)
                                                                                                        .ServerOperation(false)
                                                                                                        .Model(model =>
                                                                                                        {
                                                                                                            model.Id(p => p.Id);
                                                                                                        })
                                                                                                        .Read(read => read.Action("ManagerReportRead", "ManagerReport", new { id = ViewBag.TypeId }))
                                                                                                        .Destroy(destroy => destroy.Action("ManagerReportDestroy", "ManagerReport"))
                                                                                                    )
                        )
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb0">
                            <a href="@Url.Action("Index","ManagerReport",new {typeId = (int)ManagerReportType.Weekly })" class="report-type-btn  bg-green mb0 text-center ">
                                <h3>@ManagerReportType.Weekly.GetDisplayName()</h3>
                            </a>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb0">
                            <a href="@Url.Action("Index","ManagerReport",new {typeId = (int)ManagerReportType.Monthly })" class="report-type-btn  bg-blue-grey mb0 text-center ">
                                <h3>@ManagerReportType.Monthly.GetDisplayName()</h3>
                            </a>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb0">
                            <a href="@Url.Action("Index","ManagerReport",new {typeId = (int)ManagerReportType.Board })" class="report-type-btn  bg-deep-purple mb0 text-center ">
                                <h3>@ManagerReportType.Board.GetDisplayName()</h3>
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb0">
                            <a href="@Url.Action("Index","ManagerReport",new {typeId = (int)ManagerReportType.Convention })" class="report-type-btn  bg-deep-orange mb0 text-center ">
                                <h3>@ManagerReportType.Convention.GetDisplayName()</h3>
                            </a>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb0">
                            <a href="@Url.Action("Index","ManagerReport",new {typeId = (int)ManagerReportType.HR })" class="report-type-btn  bg-light-blue mb0 text-center ">
                                <h3>@ManagerReportType.HR.GetDisplayName()</h3>
                            </a>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb0">
                            <a href="@Url.Action("Index","ManagerReport",new {typeId = (int)ManagerReportType.Operation })" class="report-type-btn  bg-teal mb0 text-center ">
                                <h3>@ManagerReportType.Operation.GetDisplayName()</h3>
                            </a>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb0">
                            <a href="@Url.Action("Index","ManagerReport",new {typeId = (int)ManagerReportType.HSE })" class="report-type-btn  bg-light-green mb0 text-center ">
                                <h3>@ManagerReportType.HSE.GetDisplayName()</h3>
                            </a>
                        </div>

                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mb0">
                            <a href="@Url.Action("Index","ManagerReport",new {typeId = (int)ManagerReportType.WarehouseMaterial })" class="report-type-btn  bg-amber mb0 text-center ">
                                <h3>@ManagerReportType.WarehouseMaterial.GetDisplayName()</h3>
                            </a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@if (IsGranted("PmPortal.Reports.ManagerReports.Create"))
{
    <div class="modal fade" id="addManagerReportModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form id="addManagerReportForm" asp-action="AddManagerReport" asp-controller="ManagerReport" method="post" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h4 class="modal-title" id="defaultModalLabel">Add New Manager Report</h4>
                    </div>
                    <hr />
                    <div class="modal-body">
                        <div class="row">

                            <div class="col-md-6">
                                <label for="">Start Date</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.TextBoxFor(model => model.StartDate, new { @class = "form-control simple-datepicker", placeholder = "", autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="">End Date</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.TextBoxFor(model => model.EndDate, new { @class = "form-control simple-datepicker", placeholder = "", autocomplete = "off" })
                                    </div>
                                </div>
                            </div>



                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <label for="">Related File</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        <input id="ManagerReportInput" name="ManagerReportInput" type="file" class="m-t-15" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="">Report Type</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.DropDownListFor(model => model.ManagerReportType, Html.GetEnumSelectList(typeof(ManagerReportType)), "--- Select ---", new { @class = "form-control", required = "true" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <label for="">Description</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.TextBoxFor(model => model.Description, new { @class = "form-control", placeholder = "", autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success m-t-15 m-r-15 waves-effect pull-right">Save</button>
                        <a data-dismiss="modal" class="btn btn-warning m-t-15 waves-effect pull-right">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<script>
    $("#addManagerReportForm").submit(function (e) {
        e.preventDefault();
        console.log('Doing ajax submit');
        var formAction = $(this).attr("action");

        var fdata = new FormData(this);

        var fileInput = $('#ManagerReportInput')[0];
        var file = fileInput.files[0];
        fdata.append("file", file);

        $.ajax({
            type: 'post',
            url: formAction,
            data: fdata,
            enctype: 'multipart/form-data',
            processData: false,
            contentType: false
        }).done(function (result) {
            if (result.status === "success") {
                $('#addManagerReportModal').modal('hide');
                $('#addManagerReportForm').trigger("reset");
                $('#ManagerReportGrid').data('kendoGrid').dataSource.read();
                $('#ManagerReportGrid').data('kendoGrid').refresh();
            } else {
                alert(result.message);
            }
        });
    });

    function onManagerReportDownload(e) {
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        if (dataItem.FileUrl) {
            window.open(
                dataItem.FileUrl,
                '_blank' // <- This is what makes it open in a new window.
            );
        }
        else {
            alert("No file available");
        }

    }

    function onManagerReportEdit(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        generateManagerReportForm(dataItem.id);
    }

    function generateManagerReportForm(id) {
        $.ajax({
            type: "GET",
            url: "/ManagerReport/OpenManagerRportForm?id=" + id,
            success: function (response) {
                var dvItems = $("#ManagerReportFormWrapper");
                dvItems.empty();
                dvItems.html(response);
                $('#ManagerReportModal').modal('show');
            },
            failure: function (response) {
                alert(response);
            }
        });
    }





    function destroyPermission() {
        return abp.auth.isGranted("PmPortal.Reports.ManagerReports.Delete");
    }


    function editManagerReport_Permission() {
        return abp.auth.isGranted("PmPortal.Reports.ManagerReports.Edit");
    }

</script>


<div class="modal fade" id="ManagerReportModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="ManagerReportFormWrapper">

        </div>
    </div>
</div>


<style>
    .report-type-btn {
        display: block;
        padding: 20px 0px 25px 0px;
    }

        .report-type-btn:hover {
            text-decoration: none;
        }

        .report-type-btn h3 {
            font-size: 20px;
            font-weight: normal;
        }
</style>
