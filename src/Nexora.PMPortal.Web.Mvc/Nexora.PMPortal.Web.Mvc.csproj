      <HintPath>..\..\lib\Kendo\Kendo.Mvc.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Kendo.DynamicLinq">
      <HintPath>..\..\lib\Kendo\Kendo.DynamicLinq.dll</HintPath>
